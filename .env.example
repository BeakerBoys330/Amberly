# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave empty to run Amberly with sharing turned off (everything stays on-device).
# The publishable key is safe in the app: Row Level Security (supabase/schema.sql)
# limits every user to their own data. Never put the "secret" / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional bot check on sign-in (Cloudflare Turnstile "site key", public). The matching
# secret key goes only into Supabase → Authentication → Attack Protection, never here.
VITE_TURNSTILE_SITE_KEY=
